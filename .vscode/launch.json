{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Jlink_Debug",
            "cwd": "${workspaceFolder}",           
            "executable": "Firmware\\build\\ODriveFirmware.elf",  
            "request": "launch",
            "type": "cortex-debug",
            "runToEntryPoint": "main",
            "servertype": "jlink",
            "interface": "swd",
            "device": "STM32F405RG",
            "toolchainPrefix": "arm-none-eabi",
            
            // 关键修改1：明确指定GDB路径
            "gdbPath": "E:\\Odrvie\\PATH\\gcc-arm-none-eabi-10.3-2021.10-win32\\gcc-arm-none-eabi-10.3-2021.10\\bin\\arm-none-eabi-gdb.exe",
            
            // 关键修改2：添加objdump和nm路径（解决ENOENT错误）
            "objdumpPath": "E:\\Odrvie\\PATH\\gcc-arm-none-eabi-10.3-2021.10-win32\\gcc-arm-none-eabi-10.3-2021.10\\bin\\arm-none-eabi-objdump.exe",
            "nmPath": "E:\\Odrvie\\PATH\\gcc-arm-none-eabi-10.3-2021.10-win32\\gcc-arm-none-eabi-10.3-2021.10\\bin\\arm-none-eabi-nm.exe",
            
            "serverpath": "C:\\Program Files\\SEGGER\\JLink_V854\\JLinkGDBServerCL.exe",
            "svdFile": "F:\\GitHub\\ODrive\\Firmware\\Board\\v3\\STM32F40x.svd",
            
            // 关键修改3：源码路径映射（解决无法显示main的问题）
            "sourceFileMap": {
                "..": "F:/GitHub/ODrive/Firmware",
                "../CommonTables": "F:/GitHub/ODrive/Firmware/CommonTables",
                "/c/GitHub/ODrive/Firmware": "F:/GitHub/ODrive/Firmware",
                "Firmware/": "F:/GitHub/ODrive/Firmware/"
            },
            
            // 可选：添加预启动命令确保进入main
            "preLaunchCommands": [
                "set print demangle on",
                "set print asm-demangle on"
            ],
            
            // 可选：显示更多调试信息
            "showDevDebugOutput": "raw",  // 临时开启，查看详细GDB交互
            
            "liveWatch": {
                "enabled": true,
                "samplesPerSecond": 4
            }
        }
    ]
}
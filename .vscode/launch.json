    "version": "0.2.0",
    "configurations": [
        {
            "name": "Jlink_Debug",
            "cwd": "${workspaceFolder}",           
            "executable": "${workspaceRoot}/Firmware/build/ODriveFirmware.elf",    
            "request": "launch",
            "type": "cortex-debug",
            "runToEntryPoint": "main",
            "servertype": "jlink",
            "interface": "swd",
            "device": "STM32F405RG",
            "toolchainPrefix": "arm-none-eabi",
            "serverpath": "C:\\Program Files\\SEGGER\\JLink\\JLinkGDBServerCL.exe",
            "gdbPath": "D:\\Odrive051PATH\\gcc-arm-none-eabi-10.3-2021.10\\bin\\arm-none-eabi-gdb.exe",
            "svdFile": "${workspaceRoot}/Firmware/Board/v3/STM32F40x.svd",
            "liveWatch": {
                "enabled": true,
                "samplesPerSecond": 4
            }
        },
        {
            "name": "Run_Firmware",
            "type": "cortex-debug",
            "request": "launch",
            "executable": "${workspaceRoot}/Firmware/build/RunODrive-fw-v0.5.5.hex",
            "servertype": "jlink",
            "device": "STM32F405RG",
            "interface": "swd",
            "serverpath": "C:\\Program Files\\SEGGER\\JLink\\JLinkGDBServerCL.exe",
            "gdbPath": "D:\\Odrive051PATH\\gcc-arm-none-eabi-10.3-2021.10\\bin\\arm-none-eabi-gdb.exe"
        },
        {
            "name": "Brush_Firmware",
            "type": "cortex-debug",
            "request": "launch",
            "executable": "${workspaceRoot}/Firmware/build/BrushODrive-fw-v0.5.5.hex",
            "servertype": "jlink",
            "device": "STM32F405RG",
            "interface": "swd",
            "serverpath": "C:\\Program Files\\SEGGER\\JLink\\JLinkGDBServerCL.exe",
            "gdbPath": "D:\\Odrive051PATH\\gcc-arm-none-eabi-10.3-2021.10\\bin\\arm-none-eabi-gdb.exe"
        }
    ]
}